<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- Filters are [assembly]fully.qualified.Type - the type half needs the
               full namespace, not a namespace-relative path, or it silently matches
               nothing. Commas separate entries literally here; the %2c escaping form
               is only for the MSBuild /p: command line. -->
          <Exclude>[ConfigApi.Service]ConfigApi.Service.Infrastructure.DynamoDb.*,[ConfigApi.Service]ConfigApi.Service.Ignition.DynamoDbIgnition,[ConfigApi.Service]ConfigApi.Service.Ignition.LogIgnition,[ConfigApi.Service]ConfigApi.Service.Ignition.CorsIgnition</Exclude>
          <ExcludeByFile>**/obj/**,**/Program.cs</ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
